<?xml version="1.0" encoding="utf-8"?>
<!-- Draw inside the artwork boundary so Leanback row clipping cannot hide focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#22000000" />
            <stroke android:width="@dimen/jellytv_focus_width" android:color="@color/jellytv_accent" />
            <corners android:radius="@dimen/jellytv_radius_medium" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="@dimen/jellytv_focus_width" android:color="@color/jellytv_focus" />
            <corners android:radius="@dimen/jellytv_radius_medium" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
