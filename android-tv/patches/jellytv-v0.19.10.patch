+        <item name="inputDefaultHighlightBackground">@color/jellytv_focus_surface</item>
+        <item name="popupMenuBackground">@color/jellytv_surface</item>
+        <item name="progressBackground">@color/jellytv_elevated</item>
+        <item name="progressPrimary">@color/jellytv_accent</item>
+        <item name="progressSecondary">@color/jellytv_secondary</item>
+        <item name="controlIconBackground">@color/jellytv_surface</item>
+        <item name="controlIconForegroundActive">@color/jellytv_accent</item>
+        <item name="controlIconForegroundInactive">@color/jellytv_secondary</item>
+        <item name="cardRounding">@dimen/jellytv_radius_medium</item>
+        <item name="buttonRounding">@dimen/jellytv_radius_large</item>
+        <item name="inputRounding">@dimen/jellytv_radius_small</item>
+        <item name="popupMenuRounding">@dimen/jellytv_radius_medium</item>
+        <item name="overlayDimDimmedLevel">15%</item>
+    </style>
+</resources>
